# Anthropic API key, used to draft the vocab paragraph + word list
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Facebook Page access token (long-lived Page token, NOT a user token)
# How to get one: see README.md "Facebook setup" section
FB_PAGE_ACCESS_TOKEN=EAAxxxxxxxx
FB_PAGE_ID=1234567890

# Graph API version to target
FB_GRAPH_VERSION=v20.0

# TTSMaker API key, used to narrate the lesson (https://ttsmaker.com)
TTSMAKER_API_KEY=xxxxxxxx
