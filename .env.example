# Anthropic API key, used to draft the vocab paragraph + word list
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Facebook Page access token (long-lived Page token, NOT a user token)
# How to get one: see README.md "Facebook setup" section
FB_PAGE_ACCESS_TOKEN=EAAxxxxxxxx
FB_PAGE_ID=1234567890

# Graph API version to target
FB_GRAPH_VERSION=v20.0

# TTSMaker API key, used to narrate the lesson (https://ttsmaker.com)
TTSMAKER_API_KEY=xxxxxxxx

# TiengDong TTS (https://tiengdong.com/text-to-speech) — the engine currently
# wired in container.py. No official API; this replays the same request the
# site's own "Convert" button makes, authenticated with a browser session
# instead of an API key, so it goes stale over time. To (re)capture both
# values: open the TTS page, convert any text, open DevTools → Network, find
# the `admin-ajax.php` request, and copy these two Cookie values from it.
TIENGDONG_PHPSESSID=xxxxxxxx
TIENGDONG_COOKIE_ID=atts_xxxxxxxx
# Optional — defaults to en-US-Standard-E
TIENGDONG_VOICE=en-US-Standard-E
