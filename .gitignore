# Environment / secrets
.env
*.env
!.env.example

# Credential files. Blocked by directory AND by name: a key is unrecoverable
# once it reaches git history, and several sessions share this working tree.
credentials/*
!credentials/.gitkeep
secrets/*
!secrets/.gitkeep
service-account*.json
*-service-account.json
*.pem
*.p12

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Generated project output (media, drafts)
output/*
!output/.gitkeep
drafts/*.md
!drafts/.gitkeep

# Claude Code local settings
.claude/settings.local.json

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Gitnexus
.gitnexus/

# Assets — only the brand images, which `scripts/build_brand_assets.py`
# regenerates; assets/fonts/ stays tracked so a font added later isn't
# silently swallowed the way a bare `assets/*` would swallow it.
assets/brand/